# ⚠️ [已退役 2026-07-21,Arc 2:改由 ModelManager 纳管]
# spec 2026-07-20-moss-asr-sglang-serving-design.md §7:MOSS 已改由 backend 的 ModelManager
# 起 sgl-omni serve 子进程统一管理(configs/models.d/moss_transcribe_diarize.yaml,resident 常驻,
# SGLangOmniAdapter)。本 systemd unit **不再使用**,保留仅作历史参考 + 回滚锚点。
# 生产切换:sudo systemctl disable --now nous-engine-moss-asr && sudo rm /etc/systemd/system/nous-engine-moss-asr.service
#           && sudo systemctl daemon-reload && sudo systemctl restart nous-engine-backend
# 切换后 backend 重启会自动拉起 resident MOSS。**别与本 unit 同时开**(双头抢同一张卡/端口)。
#
# 2026-09-05 #709:MOSS 已从 3090 搬到 Pro 6000(两张 3090 整块让给 Qwen3.8 做 tp=2)。
# 本 unit 作为回滚锚点,CUDA_VISIBLE_DEVICES 已同步更新到 Pro 6000 的 UUID —— 必须与
# backend/configs/models.d/moss_transcribe_diarize.yaml 的 params.gpu_uuid 一致,
# 否则回滚会把 ASR 拉到 GPU 0(显示卡)上去。
[Unit]
Description=nous-engine MOSS-Transcribe-Diarize ASR 微服务(SGLang Omni,独立 venv,2026-07-20;已退役 Arc 2)
# 不 Requires/PartOf nous-engine-backend —— 独立进程/venv(sglang-omni 自带 torch 2.11+cu130 /
# transformers 5.6,与 backend 的 vllm 0.22/torch 2.11 钉两条独立升级轨,不牵扯,故隔离)。
# backend 经 HTTP(NOUS_MOSS_ASR_URL)调它做 ASR;它挂了转写主路返回 503(MOSS 已是唯一 ASR)。
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=heygo
Group=heygo
WorkingDirectory=/media/heygo/program/projects-code/repos/nous-engine/infra/moss-asr
# 独立 venv + 全部 GPU/CUDA_HOME/PATH/端口 出口都在 start_serve.sh 里(sh 脚本启动,
# 进程 cmdline 干净,便于 cgroup 收束)。
ExecStart=/media/heygo/program/projects-code/repos/nous-engine/infra/moss-asr/start_serve.sh
# UUID 钉到 index0 的 Pro 5000(72GB)。裸 cuda:0 随枚举顺序/槽位变不可靠;UUID 绑定不变。
# 2026-09-20 两卡改造:原先钉的是 Pro 6000(GPU-d24ed424…),那张现在**由 ComfyUI 独占**,
# ASR 绝不能落上去。start_serve.sh 里也 export 了同一 UUID(直接跑脚本时生效),这里再
# 声明一份保证 systemd 路径同样钉死。**四处同步**:本文件、start_serve.sh、
# backend/configs/models.d/moss_transcribe_diarize.yaml 的 params.gpu_uuid(生产真相源)、
# backend/src/services/inference/asr_sglang.py 的缺省值。
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=CUDA_VISIBLE_DEVICES=GPU-f4334111-b8d2-4df3-ea0f-6177698f8ce9
Environment=NOUS_MOSS_ASR_PORT=8003
Environment=MODELS_ROOT=/media/heygo/program/models
Restart=on-failure
RestartSec=10
# 首次部署冷启会现场 nvcc 编译 sgl-kernel(数分钟);Type=simple 下 systemd 不按就绪门杀,
# 但给足超时余量,防未来若改 Type=notify 时冷启被误判超时。warm 之后 ~秒级起。
TimeoutStartSec=600
# sglang 常驻内存(host RAM,非显存)不小;给 24G 上限防意外泄漏拖垮宿主。
MemoryMax=24G
# KillMode 用默认 control-group(不写 KillMode= 即此):停服时收整个 cgroup,连 sglang
# worker 子进程一起杀。SPIKE.md 记了教训——worker cmdline 不含 config 名,只杀主进程会留孤儿
# 占显存(实测累积 5 个孤儿吃掉 22GB)。control-group 天然根治,故生产 unit 无此问题。
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
