[Unit]
Description=nous-engine ComfyUI sidecar
After=network.target
# --listen 里点名了 Tailscale 地址,网卡没起来时 bind 会 EADDRNOTAVAIL。
# After= 不保证地址已配好(网卡 up ≠ 有 IP),真正兜底的是下面的 Restart=on-failure。
After=tailscaled.service

# 安全边界(2026-09-07):ComfyUI 自身**零鉴权**,而它的节点能读写任意文件、执行
# 自定义代码 —— 监听 0.0.0.0 等于把这台机器交给局域网/Tailnet 上的任何人。
# 所以**逐个点名**要开口的网卡,不用通配符:
#   127.0.0.1   → 后端桥(NOUS_COMFY_URL)+ 本机浏览器
#   Tailscale   → 用户从别的机器开界面走这个
# LAN(192.168.8.x)、docker0/br-*(172.x)、mihomo 的 Meta(198.18.x)一个口都不开。
# main.py:450 对 --listen 做 address.split(","),每个地址各起一个 TCPSite。
# 这条由 tests/test_infra_privilege_boundary.py 逐个地址兜住:任一项是
# 0.0.0.0 / :: / * / 空 就红,且回环不能被摘掉(摘了后端桥 Connection refused)。
#
# **具体地址不写在这儿** —— 见 infra/network.env 的 NOUS_COMFY_LISTEN,
# 那是单一真相源,换网/换机只改那一个文件。
#
# 2026-09-21:ZeroTier 换成 Tailscale。原地址 10.0.0.10 已不在任何网卡上 ——
# 换之前这里是「进程还绑着旧 socket、一重启就 EADDRNOTAVAIL」的待爆状态。
[Service]
Type=simple
User=heygo
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
# **用 UUID 钉卡,不用索引** —— 索引随插拔/枚举漂移,UUID 不会。
# 2026-09-20 两张 3090 物理拔除、换上 Pro 5000:这次 Pro 6000 的索引碰巧还是 1,
# 但同一次改动里 hardware.yaml 与七条 DB override 全要跟着重写,就是因为索引会变。
# MOSS ASR 早就是 UUID 钉卡的,这里对齐。
# GPU-d24ed424… = RTX PRO 6000 Blackwell 96GB(另一张 GPU-f4334111… 是 Pro 5000,
# 跑全部推理服务,ComfyUI 不能看见它,否则会挤掉常驻模型)。
#
# 旧注释提到的「GSP 缓解脚本」已不再是前置:Pro 6000 满载崩卡的 GSP 固件 bug
# 于 2026-08-11 经用户确认解决,infra/gpu/README.md 留档只供复发排查。
Environment=CUDA_VISIBLE_DEVICES=GPU-d24ed424-5712-55e9-9b95-77d997ac80dc
# 现成 ComfyUI 安装(v0.31.0, 自带 .venv)
WorkingDirectory=/media/heygo/program/projects-code/github-repos/ComfyUI
# 参数与用户手动启动习惯完全一致(8888 供 IC 直连 + nous 桥;output 落 cache 盘)
# 内网地址来自单一真相源 infra/network.env —— 换网只改那个文件。
# **没有 `-` 前缀是故意的**:文件缺失时 systemd 直接让本单元启动失败(fail-closed)。
# 若写成 `-` 容错,NOUS_COMFY_LISTEN 会展开成空串 → `--listen ` 空地址 →
# ComfyUI 可能当通配符绑全网卡,而它零鉴权。宁可起不来,也不能悄悄全开。
EnvironmentFile=/media/heygo/program/projects-code/repos/nous-engine/infra/network.env
ExecStart=/media/heygo/program/projects-code/github-repos/ComfyUI/.venv/bin/python main.py --output-directory /media/heygo/cache/output/comfyui --listen ${NOUS_COMFY_LISTEN} --port 8888
# 开机时 Tailscale 可能比本单元晚拿到地址,bind 失败 → 这里重试到网卡就绪。
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
