{
  "name": "nous-engine",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "wasm:build": "cd wasm/audio-engine && wasm-pack build --target web --out-dir ../../src/wasm/pkg",
    "wasm:dev": "cd wasm/audio-engine && wasm-pack build --target web --dev --out-dir ../../src/wasm/pkg",
    "predev": "npm run wasm:build",
    "prebuild": "npm run wasm:build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.106.1",
    "@xyflow/react": "^12.12.1",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.0"
  }
}
